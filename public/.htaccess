# Configuración para el servidor Apache (IONOS / 1&1)

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS y dominio sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Portada: idioma según el navegador (español por defecto)
  RewriteCond %{HTTP:Accept-Language} ^de [NC]
  RewriteRule ^$ /de/ [L,R=302]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [L,R=302]
  RewriteRule ^$ /es/ [L,R=302]

  # URLs de la antigua web en WordPress
  RewriteRule ^quienes-somos/?$ /es/#nosotros [L,R=301,NE]
  RewriteRule ^como-lo-hacemos/?$ /es/#servicios [L,R=301,NE]
  RewriteRule ^contacto/?$ /es/#contacto [L,R=301,NE]
  RewriteRule ^politica-de-privacidad-cookies-y-aviso-legal/?$ /es/legal/ [L,R=301]
  RewriteRule ^declaracion-de-accesibilidad/?$ /es/accesibilidad/ [L,R=301]
  RewriteRule ^wp-content/ / [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
