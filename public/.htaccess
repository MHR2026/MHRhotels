# Configuración para el servidor Apache (IONOS / 1&1)

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio definitivo: forzar https://mhrhotels.com (sin www)
  RewriteCond %{HTTP_HOST} ^(www\.)?mhrhotels\.com$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mhrhotels.com%{REQUEST_URI} [L,R=301]

  # Portada: idioma según el navegador (español por defecto)
  RewriteCond %{HTTP:Accept-Language} ^de [NC]
  RewriteRule ^$ /de/ [L,R=302]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [L,R=302]
  RewriteRule ^$ /es/ [L,R=302]

  # URLs de la antigua web en WordPress (conservan el posicionamiento en Google)
  RewriteRule ^quienes-somos/?$ /es/#nosotros [L,R=301,NE]
  RewriteRule ^como-lo-hacemos/?$ /es/#servicios [L,R=301,NE]
  RewriteRule ^contacto/?$ /es/#contacto [L,R=301,NE]
  RewriteRule ^establecimientos/?$ /es/#establecimientos [L,R=301,NE]
  RewriteRule ^politica-de-privacidad-cookies-y-aviso-legal/?$ /es/legal/ [L,R=301]
  RewriteRule ^declaracion-de-accesibilidad/?$ /es/accesibilidad/ [L,R=301]
  RewriteRule ^(wp-content|wp-includes|wp-admin|wp-json|feed|comments)(/.*)?$ / [L,R=301]
  RewriteRule ^(wp-login|xmlrpc)\.php$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTTPS obligatorio en el navegador para el dominio definitivo (no afecta a subdominios)
  <If "%{HTTPS} == 'on' && %{HTTP_HOST} == 'mhrhotels.com'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>

  # La web de pruebas (2026.mhrhotels.com, etc.) no debe aparecer en Google
  <If "%{HTTP_HOST} != 'mhrhotels.com' && %{HTTP_HOST} != 'www.mhrhotels.com'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
