---
import type { Hotel } from '../data/hotels';
interface Props { hotel: Hotel; class?: string; eager?: boolean }
const { hotel, class: className = '', eager = false } = Astro.props;
---
<img src={hotel.images[0]} alt={hotel.name} loading={eager ? 'eager' : 'lazy'} decoding="async"
     fetchpriority={eager ? 'high' : undefined} class={`object-cover ${className}`} />
