---
import { languages, useTranslations } from '../i18n/ui';
import type { Lang } from '../data/hotels';
import { owners } from '../i18n/owners';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const localized = /^\/(es|en|de)(\/|$)/.test(Astro.url.pathname);
const path = localized ? Astro.url.pathname.replace(/^\/(es|en|de)/, '') : '/';
const links = [
  ['#nosotros', t('nav.about')],
  ['#servicios', t('nav.services')],
  ['#establecimientos', t('nav.hotels')],
  ['#contacto', t('nav.contact')],
];
---
<header class="sticky top-0 z-40 border-b border-sand-200 bg-sand-50/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={`/${lang}/`} class="flex items-center gap-3" aria-label="MHR Hotels">
      <img src="/images/mhr/logo-redondo.png" alt="" width="44" height="44" class="h-11 w-11" />
      <span class="hidden font-serif text-xl tracking-wide text-sea-dark sm:inline">MHR Hotels</span>
    </a>
    <nav class="flex items-center gap-5 text-sm">
      {links.map(([href, label]) => (
        <a href={`/${lang}/${href}`} class="hidden hover:text-sea lg:inline">{label}</a>
      ))}
      <a href={`/${lang}/propietarios/`} class="rounded-full bg-sea px-4 py-2 text-xs font-medium text-sand-50 hover:bg-sea-dark sm:text-sm">{owners[lang].nav}</a>
      <div class="flex gap-1 text-xs uppercase">
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a href={`/${l}${path}`} hreflang={l} aria-label={languages[l]}
             aria-current={l === lang ? 'true' : undefined}
             class:list={['rounded px-2 py-1', l === lang ? 'bg-sea text-sand-50' : 'hover:text-sea']}>{l}</a>
        ))}
      </div>
    </nav>
  </div>
</header>
