---
import Base from '../../../layouts/Base.astro';
import HotelImage from '../../../components/HotelImage.astro';
import { hotels, type Lang } from '../../../data/hotels';
import { languages, useTranslations } from '../../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).flatMap((lang) =>
    hotels.map((hotel) => ({ params: { lang, slug: hotel.slug }, props: { hotel } })),
  );
}

const { hotel } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const bookingUrl = hotel.bookingUrl ?? hotel.website;
---
<Base lang={lang} title={`${hotel.name} · MHR Hotels`} description={hotel.tagline?.[lang] ?? hotel.name}>
  <section class="relative">
    <HotelImage hotel={hotel} class="h-[55vh] min-h-80 w-full" />
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-14 lg:grid-cols-[1fr_320px]">
    <div>
      <a href={`/${lang}/#hoteles`} class="text-sm text-sea hover:underline">← {t('hotel.back')}</a>
      <p class="mt-6 text-xs uppercase tracking-widest text-terracotta">
        {hotel.location}{hotel.adultsOnly && ` · ${t('hotels.adultsOnly')}`}
      </p>
      <h1 class="mt-1 text-5xl text-sea">{hotel.name}</h1>
      {hotel.description
        ? <p class="mt-6 text-lg leading-relaxed text-stone-ink/80">{hotel.description[lang]}</p>
        : <p class="mt-6 rounded-lg border border-dashed border-sand-200 p-4 text-sm text-stone-ink/60">{t('hotel.pending')}</p>}

      {hotel.amenities && hotel.amenities.length > 0 && (
        <>
          <h2 class="mt-12 text-3xl text-sea">{t('hotel.amenities')}</h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {hotel.amenities.map((a) => <li class="before:mr-2 before:text-terracotta before:content-['◆']">{a[lang]}</li>)}
          </ul>
        </>
      )}

      {hotel.images.length > 1 && (
        <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {hotel.images.slice(1).map((src) => <img src={src} alt={hotel.name} loading="lazy" class="aspect-square w-full rounded-lg object-cover" />)}
        </div>
      )}
    </div>

    <aside class="h-fit rounded-xl bg-white p-6 shadow-sm ring-1 ring-sand-200 lg:sticky lg:top-24">
      <p class="font-serif text-2xl">{hotel.name}</p>
      {hotel.address && <p class="mt-2 text-sm text-stone-ink/70">{hotel.address}</p>}
      {hotel.phone && <p class="mt-1 text-sm"><a href={`tel:${hotel.phone}`}>{hotel.phone}</a></p>}
      {hotel.email && <p class="mt-1 text-sm"><a href={`mailto:${hotel.email}`}>{hotel.email}</a></p>}
      <a href={bookingUrl} target="_blank" rel="noopener"
         class="mt-6 block rounded-full bg-sea px-6 py-3 text-center text-sm font-medium text-sand-50 hover:bg-sea-dark">{t('cta.book')}</a>
      <a href={hotel.website} target="_blank" rel="noopener"
         class="mt-3 block text-center text-sm text-sea hover:underline">{t('cta.website')} ↗</a>
    </aside>
  </section>
</Base>
