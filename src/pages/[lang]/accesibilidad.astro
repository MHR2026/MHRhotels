---
import Prose from '../../layouts/Prose.astro';
import a11y from '../../content/accesibilidad.es.html?raw';
import { langPaths, useTranslations } from '../../i18n/ui';
import type { Lang } from '../../data/hotels';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Prose lang={lang} title={t('a11y.title')} note={t('legal.onlyEs') || undefined}>
  <Fragment set:html={a11y} />
</Prose>
