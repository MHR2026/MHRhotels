---
import Base from '../../layouts/Base.astro';
import HotelCard from '../../components/HotelCard.astro';
import { company, hotels, type Lang } from '../../data/hotels';
import { langPaths, useTranslations } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const services = [
  { key: 'marketing', icon: 'M3 3v18h18M7 15l4-4 3 3 5-6' },
  { key: 'management', icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6' },
  { key: 'tech', icon: 'M4 5h16v11H4zM8 20h8M12 16v4' },
] as const;
---
<Base lang={lang} title={t('meta.title')} description={t('meta.description')} image="/images/es-rafal-roig/1.webp">
  <section class="relative isolate flex min-h-[78vh] items-end overflow-hidden text-sand-50">
    <img src="/images/filicumis/4.webp" alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-sea-dark/90 via-sea-dark/45 to-sea-dark/10"></div>
    <div class="mx-auto w-full max-w-6xl px-4 pb-20 pt-40">
      <p class="text-sm uppercase tracking-[0.3em] text-sand-200">{t('hero.kicker')}</p>
      <h1 class="mt-4 max-w-3xl text-5xl leading-[1.05] sm:text-7xl">{t('hero.title')}</h1>
      <p class="mt-6 max-w-xl text-lg text-sand-100/90">{t('hero.subtitle')}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#establecimientos" class="rounded-full bg-sand-50 px-7 py-3 text-sm font-medium text-sea-dark hover:bg-sand-100">{t('hero.cta')}</a>
        <a href="#contacto" class="rounded-full border border-sand-50/70 px-7 py-3 text-sm font-medium hover:bg-sand-50/10">{t('hero.contact')}</a>
      </div>
    </div>
  </section>

  <section id="nosotros" class="mx-auto grid max-w-6xl scroll-mt-20 items-center gap-12 px-4 py-24 lg:grid-cols-2">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-terracotta">{t('about.kicker')}</p>
      <h2 class="mt-3 text-4xl text-sea-dark sm:text-5xl">{t('about.title')}</h2>
      <p class="mt-6 text-lg leading-relaxed text-stone-ink/80">{t('about.text')}</p>
      <a href={company.parent.url} target="_blank" rel="noopener" class="mt-6 inline-block text-sm font-medium text-sea hover:underline">{company.parent.name} ↗</a>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <img src="/images/son-sampoli/5.webp" alt="Agroturismo Son Sampoli" loading="lazy" class="aspect-[3/4] w-full rounded-xl object-cover" />
      <img src="/images/mar-i-vent-portocolom/2.webp" alt="Mar i Vent Portocolom" loading="lazy" class="mt-12 aspect-[3/4] w-full rounded-xl object-cover" />
    </div>
  </section>

  <section id="servicios" class="scroll-mt-20 bg-sand-100">
    <div class="mx-auto max-w-6xl px-4 py-24">
      <h2 class="text-4xl text-sea-dark sm:text-5xl">{t('services.title')}</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {services.map((s) => (
          <div class="rounded-xl bg-white p-8 ring-1 ring-sand-200">
            <svg viewBox="0 0 24 24" class="h-9 w-9 text-teal" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            <h3 class="mt-5 text-2xl text-sea-dark">{t(`services.${s.key}.title`)}</h3>
            <p class="mt-3 leading-relaxed text-stone-ink/75">{t(`services.${s.key}.text`)}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-2xl text-lg text-stone-ink/80">{t('services.closing')}</p>
    </div>
  </section>

  <section id="establecimientos" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24">
    <h2 class="text-4xl text-sea-dark sm:text-5xl">{t('hotels.title')}</h2>
    <p class="mt-4 max-w-2xl text-lg text-stone-ink/75">{t('hotels.subtitle')}</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {hotels.map((hotel) => <HotelCard hotel={hotel} lang={lang} />)}
    </div>
  </section>

  <section id="contacto" class="scroll-mt-20 bg-sea text-sand-50">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-24 lg:grid-cols-2">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-sand-200">{t('contact.kicker')}</p>
        <h2 class="mt-3 text-4xl sm:text-5xl">{t('contact.title')}</h2>
      </div>
      <dl class="space-y-6 text-lg">
        <div><dt class="text-xs uppercase tracking-widest text-sand-200">{t('contact.address')}</dt><dd class="mt-1">{company.address}</dd></div>
        <div><dt class="text-xs uppercase tracking-widest text-sand-200">{t('contact.email')}</dt><dd class="mt-1"><a class="underline-offset-4 hover:underline" href={`mailto:${company.email}`}>{company.email}</a></dd></div>
        <div><dt class="text-xs uppercase tracking-widest text-sand-200">{t('contact.phone')}</dt><dd class="mt-1"><a class="underline-offset-4 hover:underline" href={`tel:${company.phoneHref}`}>{company.phone}</a></dd></div>
      </dl>
    </div>
  </section>
</Base>
