---
import Base from '../../layouts/Base.astro';
import HotelCard from '../../components/HotelCard.astro';
import { hotels, type Lang } from '../../data/hotels';
import { langPaths, useTranslations } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} title={`MHR Hotels · ${t('hero.title')}`} description={t('hero.subtitle')}>
  <section class="relative isolate overflow-hidden bg-sea-dark text-sand-50">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-sea-dark via-sea to-terracotta/70"></div>
    <div class="mx-auto max-w-6xl px-4 py-28 sm:py-40">
      <p class="text-sm uppercase tracking-[0.3em] text-sand-200">Mallorca</p>
      <h1 class="mt-4 max-w-3xl text-5xl leading-tight sm:text-6xl">{t('hero.title')}</h1>
      <p class="mt-6 max-w-xl text-lg text-sand-100/90">{t('hero.subtitle')}</p>
      <a href="#hoteles" class="mt-10 inline-block rounded-full bg-sand-50 px-7 py-3 text-sm font-medium text-sea-dark hover:bg-sand-100">
        {t('hotels.title')}
      </a>
    </div>
  </section>

  <section id="hoteles" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
    <h2 class="text-4xl text-sea">{t('hotels.title')}</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {hotels.map((hotel) => <HotelCard hotel={hotel} lang={lang} />)}
    </div>
  </section>

  <section id="nosotros" class="scroll-mt-20 bg-sand-100">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center">
      <h2 class="text-4xl text-sea">{t('about.title')}</h2>
      <p class="mt-6 text-lg text-stone-ink/80">{t('about.text')}</p>
    </div>
  </section>

  <section id="contacto" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-20 text-center">
    <h2 class="text-4xl text-sea">{t('contact.title')}</h2>
    <p class="mt-6 text-stone-ink/80">{t('contact.text')}</p>
  </section>
</Base>
