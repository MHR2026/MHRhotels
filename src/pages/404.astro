---
import Base from '../layouts/Base.astro';
---
<Base lang="es" title="Página no encontrada · MHR Hotels">
  <section class="mx-auto max-w-2xl px-4 py-32 text-center">
    <p class="font-serif text-7xl text-teal">404</p>
    <h1 class="mt-4 text-4xl text-sea-dark">Página no encontrada</h1>
    <p class="mt-4 text-stone-ink/75">Page not found · Seite nicht gefunden</p>
    <div class="mt-10 flex justify-center gap-3 text-sm">
      <a href="/es/" class="rounded-full bg-sea px-6 py-3 text-sand-50">Inicio</a>
      <a href="/en/" class="rounded-full border border-sea px-6 py-3 text-sea">Home</a>
      <a href="/de/" class="rounded-full border border-sea px-6 py-3 text-sea">Startseite</a>
    </div>
  </section>
</Base>
