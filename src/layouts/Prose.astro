---
import Base from './Base.astro';
import type { Lang } from '../data/hotels';
interface Props { lang: Lang; title: string; note?: string }
const { lang, title, note } = Astro.props;
---
<Base lang={lang} title={`${title} · MHR Hotels`}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl text-sea-dark sm:text-5xl">{title}</h1>
    {note && <p class="mt-4 rounded bg-sand-100 px-4 py-2 text-sm">{note}</p>}
    <div class="prose mt-10"><slot /></div>
  </article>
</Base>
